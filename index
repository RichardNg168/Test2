  transition: border-color .25s ease, color .25s ease, background .25s ease;
}
.cad-opt:hover { border-color: var(--pine); color: var(--pine); }
.cad-opt.is-on { background: var(--pine); border-color: var(--pine); color: var(--paper); }

.week {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: .5rem;
  align-items: end;
}
.day { text-align: center; }
.mark {
  display: block;
  width: 100%;
  aspect-ratio: 1 / 1.9;
  border: 1px solid var(--line);
