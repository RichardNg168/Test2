  transform-origin: bottom;
  transition: background .4s ease, border-color .4s ease, transform .4s cubic-bezier(.34, 1.3, .64, 1);
}
.day.is-visit .mark {
  background: var(--pine);
  border-color: var(--pine);
}
.dl {
  display: block;
  font-size: .64rem;
  letter-spacing: .14em;
  text-transform: uppercase;
