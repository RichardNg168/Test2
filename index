/* --------------------------------------------------------------------------
   Signature: the cleaning cadence rail
   -------------------------------------------------------------------------- */

.cadence {
  background: var(--paper);
  border: 1px solid var(--line);
  padding: clamp(1.75rem, 3vw, 2.5rem);
}

.cadence-opts {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: .5rem;
  margin-bottom: 2.2rem;
}
.cad-opt {
  background: transparent;
  border: 1px solid var(--line);
