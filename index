<script>

(function () {
  'use strict';
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var TITLES = {
    home:     'Yuki & White — Office Cleaning Services in Singapore Since 1999',
    about:    'About Us — Yuki & White | Office Cleaning Singapore',
    services: 'Our Services — Office Cleaning, Carpet Shampooing & Disinfecting | Yuki & White',
    faq:      'FAQ — Office Cleaning Questions Answered | Yuki & White',
    contact:  'Contact Us — Yuki & White | Office Cleaning Singapore',
    thanks:   'Thank You — Yuki & White'
  };

  var views = document.querySelectorAll('.view');
  var navLinks = document.querySelectorAll('.nav a[data-route]');
  var io = null;

  if (!reduce && 'IntersectionObserver' in window) {
    io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
  }

  function show(route, anchor, instant) {
    if (!TITLES[route]) { route = 'home'; }
    Array.prototype.forEach.call(views, function (v) {
      v.classList.toggle('is-active', v.id === 'view-' + route);
    });
    Array.prototype.forEach.call(navLinks, function (a) {
      if (a.getAttribute('data-route') === route) { a.setAttribute('aria-current', 'page'); }
      else { a.removeAttribute('aria-current'); }
    });
    document.title = TITLES[route];

    var active = document.getElementById('view-' + route);
    var reveals = active.querySelectorAll('.reveal');
    Array.prototype.forEach.call(reveals, function (el) {
      if (io) { el.classList.remove('is-in'); io.observe(el); }
      else { el.classList.add('is-in'); }
    });

    if (anchor) {
      var target = active.querySelector('#' + anchor);
      if (target) {
        window.requestAnimationFrame(function () {
          var top = target.getBoundingClientRect().top + window.pageYOffset - 100;
          window.scrollTo({ top: top, behavior: reduce || instant ? 'auto' : 'smooth' });
        });
        return;
      }
    }
    window.scrollTo({ top: 0, behavior: 'auto' });
  }

  function parse() {
    var h = (location.hash || '#/home').replace(/^#\//, '');
    return h.split('#')[0] || 'home';
  }

  var pendingAnchor = null;
  document.addEventListener('click', function (e) {
    var a = e.target.closest ? e.target.closest('a[href^="#/"]') : null;
    if (a) { pendingAnchor = a.getAttribute('data-anchor') || null; }
  });

  window.addEventListener('hashchange', function () {
    show(parse(), pendingAnchor, false);
    pendingAnchor = null;
  });

  /* --- Mobile navigation --- */
  var toggle = document.querySelector('.nav-toggle');
  var nav = document.getElementById('nav');
  if (toggle && nav) {
    toggle.addEventListener('click', function () {
      var open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    nav.addEventListener('click', function (e) {
      if (e.target.tagName === 'A') {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  /* --- Sticky header hairline --- */
  var head = document.querySelector('.site-head');
  if (head) {
    var onScroll = function () { head.classList.toggle('is-stuck', window.scrollY > 12); };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  /* --- Cleaning cadence rail --- */
  var cadence = document.getElementById('cadence');
  if (cadence) {
    var opts = cadence.querySelectorAll('.cad-opt');
    var days = cadence.querySelectorAll('.day');
    var note = cadence.querySelector('.cadence-note');
    var paint = function (btn) {
      var picked = btn.getAttribute('data-days').split(',');
      Array.prototype.forEach.call(days, function (day, i) {
        var on = picked.indexOf(String(i)) !== -1;
        var apply = function () { day.classList.toggle('is-visit', on); };
        if (reduce) { apply(); } else { setTimeout(apply, i * 55); }
      });
      if (note) { note.textContent = btn.getAttribute('data-note'); }
      Array.prototype.forEach.call(opts, function (o) {
        var isOn = o === btn;
        o.classList.toggle('is-on', isOn);
        o.setAttribute('aria-pressed', isOn ? 'true' : 'false');
      });
    };
    Array.prototype.forEach.call(opts, function (b) {
      b.addEventListener('click', function () { paint(b); });
    });
    paint(cadence.querySelector('.cad-opt.is-on') || opts[0]);
  }

  /* --- Enquiry form --- */
  var form = document.getElementById('enquiry');
  if (form) {
    var key = form.querySelector('[name="access_key"]');
    var redirect = form.querySelector('[name="redirect"]');
    if (redirect) {
      redirect.value = location.origin + location.pathname + '#/thanks';
    }
    form.addEventListener('submit', function (e) {
      if (key && key.value === 'PASTE_YOUR_ACCESS_KEY') {
        e.preventDefault();
        var msg = document.getElementById('formMsg');
        if (msg) {
          msg.textContent = 'This form needs an access key before it can send. Add one from web3forms.com to the access_key field.';
        }
      }
    });
  }

  /* --- Year stamp --- */
  Array.prototype.forEach.call(document.querySelectorAll('[data-year]'), function (el) {
    el.textContent = new Date().getFullYear();
  });

  show(parse(), null, true);
})();

</script>
